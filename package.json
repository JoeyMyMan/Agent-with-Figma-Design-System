{
  "name": "dsh-figma-design-system",
  "version": "0.2.1",
  "description": "DeepSeek Harness workflow for pinned Figma design tokens, component reuse, CI validation and design review.",
  "keywords": ["dsh", "dsh-plugin", "figma", "figma-mcp", "design-system", "design-tokens", "design-review"],
  "homepage": "https://github.com/JoeyMyMan/Agent-with-Figma-Design-System#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyMyMan/Agent-with-Figma-Design-System.git"
  },
  "bugs": {
    "url": "https://github.com/JoeyMyMan/Agent-with-Figma-Design-System/issues"
  },
  "type": "module",
  "main": "./dsh.mjs",
  "exports": {
    ".": "./dsh.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
