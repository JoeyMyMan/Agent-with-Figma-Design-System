{
  "name": "dsh-figma-ds",
  "version": "1.0.0",
  "private": true,
  "description": "The ds-workflow design system workflow as a DeepSeek Harness plugin: a 「设计系统」 page that reads the pinned tokens, the component registry and the review ledger, runs the check gate, and opens the agent playbooks.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "figma",
    "design-system",
    "design-tokens",
    "ds-workflow"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
